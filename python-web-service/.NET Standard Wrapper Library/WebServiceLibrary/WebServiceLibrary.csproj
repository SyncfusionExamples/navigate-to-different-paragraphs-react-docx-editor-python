<Project Sdk="Microsoft.NET.Sdk">
 
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Linux runtime identifier so native assets resolve to runtimes/linux-x64/native -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
 
  <ItemGroup>
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Syncfusion.EJ2.WordEditor.AspNet.Core" Version="33.2.15" />
    <PackageReference Include="Syncfusion.EJ2.Spreadsheet.AspNet.Core" Version="33.2.15" />
    <PackageReference Include="Syncfusion.Pdf.Net.Core" Version="33.2.15" />
    <PackageReference Include="Syncfusion.Presentation.Net.Core" Version="33.2.15" />
    <PackageReference Include="Syncfusion.PresentationRenderer.Net.Core" Version="33.2.15" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Abstractions" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Razor" Version="2.3.0" />
  </ItemGroup>
 
</Project>
